@page
@model StravaTeamApp.Areas.Identity.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "Registro Oficial con Strava";
}

<style>
    .validation-summary-valid {
        display: none !important;
    }
</style>

<div class="text-center mt-4 mb-4">
    <h2 class="fw-bold" style="color: var(--brand-dark);">@ViewData["Title"]</h2>
    <h5 id="external-login-title" class="text-success">
        Has sido autenticado exitosamente con <strong>@Model.ProviderDisplayName</strong>.
    </h5>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <p class="text-muted text-center mb-4">
            ¡Ya casi estamos listos! Confirma tus datos para terminar de crear tu cuenta en el 3M Healthy Living Hub. Tu ID de atleta se ha asociado de forma automática y segura.
        </p>
        
        <div class="card shadow-sm border-0" style="border-top: 4px solid var(--brand-red) !important;">
            <div class="card-body p-4">
                <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                    
                    <div asp-validation-summary="All" class="alert alert-danger fw-bold small" role="alert">
                        <strong>Por favor, revisa los siguientes errores:</strong>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-bold">Correo Electrónico <span class="text-danger">*</span></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger small fw-bold"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Nombre" class="form-label fw-bold">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Input.Nombre" class="form-control" />
                            <span asp-validation-for="Input.Nombre" class="text-danger small fw-bold"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Apellido" class="form-label fw-bold">Apellido <span class="text-danger">*</span></label>
                            <input asp-for="Input.Apellido" class="form-control" />
                            <span asp-validation-for="Input.Apellido" class="text-danger small fw-bold"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Genero" class="form-label fw-bold">Género <span class="text-danger">*</span></label>
                            <select asp-for="Input.Genero" class="form-select">
                                <option value="">Selecciona...</option>
                                <option value="Hombre">Hombre</option>
                                <option value="Mujer">Mujer</option>
                            </select>
                            <span asp-validation-for="Input.Genero" class="text-danger small fw-bold"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.UPIN" class="form-label fw-bold">UPIN <span class="text-danger">*</span></label>
                            <input asp-for="Input.UPIN" class="form-control" />
                            <span asp-validation-for="Input.UPIN" class="text-danger small fw-bold"></span>
                        </div>
                    </div>
                    
                    <button type="submit" formnovalidate class="btn btn-dark w-100 mt-3 fw-bold text-uppercase py-2" style="background-color: var(--brand-dark);">Completar Registro</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}