@page
@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">
    <div class="row align-items-center mb-5">

        <div class="col-lg-7 text-center text-lg-start mb-4 mb-lg-0 pe-lg-5">
            <h1 class="display-4 fw-bold" style="color: var(--brand-dark);">Bienvenido al 3M Healthy Living Hub</h1>
            <p class="lead text-muted mt-3">
                Tu centro de mando para el bienestar físico y el análisis de rendimiento deportivo.
            </p>

            <hr class="w-25 mx-auto mx-lg-0 my-4 border-primary border-3 opacity-100">

            <h4 class="fw-bold mb-3">Nuestro Propósito</h4>
            <p class="fs-5">
                Esta plataforma está diseñada para centralizar y dar un seguimiento preciso a las actividades que
                realizan los atletas a través de los diferentes clubes de Strava de 3M.
            </p>
            <p>
                Más allá de simplemente registrar kilómetros, el sistema recopila y procesa esta información para
                brindarte <strong>análisis de datos detallados</strong>. Nuestro objetivo es darte la visibilidad
                necesaria para entender el esfuerzo colectivo, identificar tendencias de rendimiento y mantener la
                motivación de todos los participantes al máximo nivel.
            </p>

            <div class="mt-5 d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                <a asp-page="/Running/Metricas"
                   class="btn btn-danger btn-lg fw-bold px-4 text-white text-uppercase shadow-sm border-0"
                   style="background-color: red;">
                    VER MÉTRICAS
                </a>
                <a asp-page="/Instrucciones"
                   class="btn btn-danger btn-lg fw-bold px-4 text-white text-uppercase shadow-sm border-0"
                   style="background-color: red;">
                    CÓMO EMPEZAR
                </a>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow bg-light p-3">
                <h5 class="text-center text-muted fw-bold mb-3">Actividad Reciente del Club</h5>
                <div class="d-flex flex-column align-items-center gap-3">

                    <div class="rounded overflow-hidden bg-white shadow-sm" style="width: 300px;">
                        <iframe allowtransparency='true' frameborder='0' height='454' scrolling='no'
                                src='https://www.strava.com/clubs/1252154/latest-rides/abea5190e75d08c3405b9d9090c08b93f5cf0af3?show_rides=true'
                                width='300'></iframe>
                    </div>

                    <div class="rounded overflow-hidden bg-white shadow-sm" style="width: 300px;">
                        <iframe allowtransparency='true' frameborder='0' height='160' scrolling='no'
                                src='https://www.strava.com/clubs/1252154/latest-rides/abea5190e75d08c3405b9d9090c08b93f5cf0af3?show_rides=false'
                                width='300'></iframe>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>