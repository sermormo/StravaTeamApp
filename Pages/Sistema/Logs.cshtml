@page
@model StravaTeamApp.Pages.Sistema.LogsModel
@{
    ViewData["Title"] = "Bitácora del Sistema";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <div>
        <h2 class="fw-bold" style="color: var(--brand-dark);">Bitácora del Sistema</h2>
        <p class="text-muted mb-0">Mantenimiento y revisión de eventos internos (Últimos 100 registros).</p>
    </div>

    <form method="post" asp-page-handler="BorrarTodos" 
          onsubmit="return confirm('¿Estás seguro de que deseas eliminar TODOS los registros de la bitácora? Esta acción no se puede deshacer.');">
        <button type="submit" class="btn btn-outline-danger shadow-sm fw-bold">
            🗑️ Vaciar Logs
        </button>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%;">Fecha</th>
                        <th style="width: 10%;">Nivel</th>
                        <th style="width: 25%;">Mensaje</th>
                        <th style="width: 50%;">Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Registros.Any())
                    {
                        @foreach (var log in Model.Registros)
                        {
                            <tr>
                                <td class="text-muted small">@log.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (log.Nivel == "Error")
                                    {
                                        <span class="badge bg-danger">@log.Nivel</span>
                                    }
                                    else if (log.Nivel == "Warning")
                                    {
                                        <span class="badge bg-warning text-dark">@log.Nivel</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@log.Nivel</span>
                                    }
                                </td>
                                <td class="fw-bold">@log.Mensaje</td>
                                <td class="small" style="word-break: break-word;">@log.Detalles</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No hay registros en la bitácora.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>