@using Microsoft.AspNetCore.Identity
@using StravaTeamApp.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <!-- El botón que despliega el menú -->
            <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="userDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                Hola, @User.Identity?.Name!
            </a>

            <!-- El contenido del menú (Texto negro + Iconos) -->
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                <li>
                    <!-- Enlace a la página de perfil -->
                    <a class="dropdown-item text-dark" href="/Sistema/Perfil">⚙️ Mi Perfil</a>

                </li>

                <li>
                    <hr class="dropdown-divider">
                </li>

                <li>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item text-dark">
                            🚪 Cerrar Sesión
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Iniciar Sesión</a>
        </li>
    }
</ul>