@page
@model StravaTeamApp.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Administración";
}

<div class="container py-4">
    <h1>Panel de administración</h1>

    <p class="text-muted">
        Desde aquí se administrarán los miembros y permisos del equipo.
    </p>

    <div class="card mt-4">
