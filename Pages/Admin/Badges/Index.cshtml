@page
@model StravaTeamApp.Pages.Admin.Badges.IndexModel

@{
    ViewData["Title"] = "Insignias";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1>Insignias</h1>

            <p class="text-muted mb-0">
                Administra las insignias y sus reglas de otorgamiento.
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            Crear insignia
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Insignias configuradas</strong>
        </div>

        <div class="card-body">
            @if (Model.Badges.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    Todavía no hay insignias configuradas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Icono</th>
                                <th>Insignia</th>
                                <th>Regla</th>
                                <th>Periodo</th>
                                <th>Meta</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var badge in Model.Badges)
                            {
                                <tr>
                                    <td>
                                        <img src="@badge.IconPath" alt="@badge.Name" width="48" height="48"
                                             class="rounded object-fit-cover" />
                                    </td>

                                    <td>
                                        <strong>@badge.Name</strong>

                                        <div class="small text-muted">
                                            @badge.Description
                                        </div>
                                    </td>

                                    <td>
                                        @badge.Operation de
                                        @badge.Metric.ToLowerInvariant()
                                    </td>

                                    <td>@badge.Period</td>

                                    <td>@badge.Target</td>

                                    <td>
                                        @if (badge.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>